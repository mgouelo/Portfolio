---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillCard from '../components/SkillCard.astro';
import SkillModal from '../components/SkillModal.astro';
import projets from '../data/projets.json';
import competences from '../data/competences.json';
import outils from '../data/outils.json';
import { asset } from '../lib/asset';
---
<Base>
  <Header />

  <main>
    <!-- =================== Hero =================== -->
    <section class="hero" id="about" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-text">
          <h1 id="hero-title">ETUDIANT<br>EN INFORMATIQUE</h1>
          <p>
            Je suis Matthieu Gouélo, étudiant créatif et passionné de développement.
            J’aime créer des sites et apps <strong>user-friendly</strong> qui combinent
            fonctionnalités et esthétisme.
          </p>
          <a class="btn btn-primary" href="#work">Mes travaux</a>
        </div>

        <figure class="hero-portrait">
          <img src={asset('assets/portrait.jpg')} alt="Portrait de Matthieu Gouélo" />
        </figure>
      </div>
    </section>

    <hr class="separator" aria-hidden="true" />

    <!-- =================== Projets =================== -->
    <section class="section" id="work" aria-labelledby="projects-title">
      <div class="container">
        <h2 id="projects-title" class="section-title">PROJETS</h2>
        <div class="projects-grid">
          {projets.map((p) => <ProjectCard {...p} />)}
        </div>
      </div>
    </section>

    <!-- =================== Skills =================== -->
    <section class="skills-carousel" aria-label="Compétences">
      <h2 class="section-title">COMPETENCES</h2>
      <div class="marquee">
        <div class="marquee-track">
          <!-- Deux bandes identiques pour le défilement en boucle -->
          {[...competences, ...competences].map((c) => <SkillCard {...c} />)}
        </div>
      </div>
    </section>

    <!-- =================== Langages & Outils =================== -->
    <section class="section" id="tools" aria-labelledby="tools-title">
      <div class="container">
        <h2 id="tools-title" class="section-title">LANGUES & OUTILS</h2>

        <ul class="tools-row">
          {outils.map((o) => <li class="tool"><img src={asset(o.icone)} alt={o.nom}></li>)}
        </ul>
      </div>
    </section>

  <!-- =================== Contact =================== -->
  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="container">
      <h2 id="contact-title" class="section-title">CONTACT</h2>

      <div class="contact-grid">
        <a class="contact-item" href="https://github.com/mgouelo" target="_blank" rel="noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 .297a12 12 0 0 0-3.79 23.4c.6.111.82-.26.82-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.547-1.388-1.336-1.758-1.336-1.758-1.091-.746.083-.73.083-.73 1.206.085 1.84 1.239 1.84 1.239 1.07 1.836 2.809 1.306 3.493.998.108-.775.418-1.306.762-1.606-2.665-.305-5.467-1.334-5.467-5.931 0-1.31.469-2.382 1.236-3.222-.124-.304-.536-1.527.117-3.183 0 0 1.008-.322 3.3 1.23a11.51 11.51 0 0 1 6.003 0c2.291-1.552 3.297-1.23 3.297-1.23.655 1.656.243 2.879.12 3.183.77.84 1.236 1.912 1.236 3.222 0 4.61-2.806 5.624-5.479 5.922.43.371.823 1.103.823 2.222v3.293c0 .319.219.694.825.576A12.003 12.003 0 0 0 12 .297z"/>
          </svg>
          <span>mgouelo</span>
        </a>

        <a class="contact-item" href="mailto:matthieugouelo@gmail.com">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 2v.511l-8 5.333-8-5.333V6h16zM4 18V8.489l7.386 4.924a1 1 0 0 0 1.228 0L20 8.489V18H4z"/>
          </svg>
          <span>matthieugouelo@gmail.com</span>
        </a>

        <a class="contact-item" href="https://www.linkedin.com/in/matthieu-gouelo/" target="_blank" rel="noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.94v5.666H9.35V9h3.414v1.561h.048c.476-.9 1.636-1.852 3.366-1.852 3.599 0 4.264 2.369 4.264 5.455v6.288zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM6.959 20.452H3.713V9h3.246v11.452zM22.225 0H1.771C.792 0 0 .771 0 1.723v20.549C0 23.229.792 24 1.771 24h20.451C23.2 24 24 23.229 24 22.271V1.723C24 .771 23.2 0 22.222 0z"/>
          </svg>
          <span>mgouelo</span>
        </a>
      </div>
    </div>
  </section>
  </main>

  <Footer />

  <SkillModal />
</Base>
