      <path class="t" pathLength="1" d="M556 392 h52 v44 h-52 Z M556 414 h52 M582 392 v44" />
      <path class="t" pathLength="1" d="M650 236 q12 -26 38 -12 q18 16 -4 30 q-26 8 -34 -18 Z" />

      <!-- rail invisible : le chemin du grimpeur -->
      <path class="rail" d="M70 840 C150 790 220 720 280 650 S400 510 450 470 S560 320 600 280 S690 140 720 96" />

      <!-- Le grimpeur : buste nu, chaudron en bulbe, long marteau -->
      <g class="grimpeur">
        <g class="grimpeur-corps">
          <!-- buste large et légèrement penché, tête chauve de profil, barbe -->
          <path class="peau" d="M-16 -44 C-20 -58 -21 -68 -15 -75 C-8 -80 10 -80 17 -74 C21 -66 19 -56 16 -44 Z" />
          <path class="peau" d="M-4 -80 V-86 H6 V-80 Z" />
          <path class="peau tete" d="M0 -107 C9 -107 12 -100 12 -95 L15 -91 L12 -89 C11 -85 6 -83 0 -83 C-6 -83 -11 -86 -11 -93 C-11 -101 -8 -107 0 -107 Z" />
          <path class="barbe" d="M-6 -90 Q-4 -82 3 -82 Q10 -83 12 -89 Q6 -86 1 -87 Q-3 -87 -6 -90 Z" />
          <path class="oreille" d="M-3 -96 q-4 0 -4 4 q0 4 4 4" />
          <!-- bras tendus et marteau : pivotent autour des épaules -->
          <g class="bras">
            <path class="manche" d="M4 -53 L80 -106" />
            <path class="marteau-tete" d="M72 -120 L92 -100 L86 -94 L66 -114 Z M82 -110 L98 -126" />
            <path class="membre-contour" d="M-11 -72 Q4 -58 18 -62 M11 -73 Q22 -66 27 -68" />
            <path class="membre" d="M-11 -72 Q4 -58 18 -62 M11 -73 Q22 -66 27 -68" />
            <path class="main" d="M18 -62 m-3.5 0 a3.5 3.5 0 1 0 7 0 a3.5 3.5 0 1 0 -7 0 M27 -68 m-3.5 0 a3.5 3.5 0 1 0 7 0 a3.5 3.5 0 1 0 -7 0" />
