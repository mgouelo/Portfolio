      <!-- la jarre couchée, une tête à l'ouverture -->
      <path class="t" pathLength="1" d="M140 700 C120 610 200 540 320 536 C430 532 520 560 560 610 L560 730 C520 780 430 800 320 796 C200 792 150 760 140 700 Z" />
      <path class="t" pathLength="1" d="M560 600 Q590 600 590 620 V720 Q590 740 560 740" />
