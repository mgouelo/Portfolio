      <g class="element" data-scenes="3">
        <path class="t conquerant" pathLength="1" d="M420 300 m-22 0 a22 22 0 1 0 44 0 a22 22 0 1 0 -44 0 M396 292 Q418 244 452 290 M420 324 L372 560 H468 Z M496 230 V580 M486 246 L496 220 L506 246" />
      </g>
    </g>

    <!-- ============ Tableau : fragile, robuste, plus fort (chapitre V) ============ -->
