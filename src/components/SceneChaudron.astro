          <path class="chaudron-bord" d="M-20 -46 H20 Q22 -46 22 -43 V-40 Q22 -38 20 -38 H-20 Q-22 -38 -22 -40 V-43 Q-22 -46 -20 -46 Z" />
          <path class="reflet" d="M-22 -24 Q-24 -12 -16 -6" />
        </g>
      </g>
    </g>

