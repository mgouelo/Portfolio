      <path class="t" pathLength="1" d="M100 800 V720 Q100 690 130 690 H420 Q450 690 450 720 V800 M130 800 V750 H420 V800 M80 800 H470 M110 820 V800 M440 820 V800" />
      <path class="t hachures" pathLength="1" d="M150 740 q30 -20 60 0 M250 740 q30 -20 60 0 M340 740 q30 -20 60 0" />
    </g>

    <!-- ============ Tableau : l'homme dans la jarre (chapitre IV) ============ -->
