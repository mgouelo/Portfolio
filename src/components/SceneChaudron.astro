---
// Décor du récit, au trait fin comme l'arcade et les colonnes de l'accueil.
// data-scenes : numéros des chapitres (à partir de 0) où le tableau ou l'élément est visible.
// Les tracés de classe « t » se dessinent à leur première apparition (voir scripts/recit.ts).
---
<div class="scene-fond" aria-hidden="true">
  <svg viewBox="0 0 800 900" fill="none" preserveAspectRatio="xMidYMid meet">
    <!-- ============ La montagne (chapitres I, II, VI, VII) ============ -->
    <g class="tableau" data-scenes="0 1 5 6">
      <g class="element" data-scenes="6">
        <path class="t" pathLength="1" d="M560 150 m-32 0 a32 32 0 1 0 64 0 a32 32 0 1 0 -64 0" />
        <path class="t fin" pathLength="1" d="M560 96 V80 M560 204 V220 M506 150 H490 M614 150 H630" />
      </g>
      <path class="t" pathLength="1" d="M40 860 L200 700 L250 730 L420 470 L470 510 L640 160 L760 400" />
      <path class="t fin" pathLength="1" d="M230 760 l26 -26 M440 540 l26 -30 M480 580 l30 -34 M660 300 l24 -28 M690 360 l26 -30" />
      <path class="t fin" pathLength="1" d="M20 860 H780" />

      <!-- rail invisible : le chemin du grimpeur, posé sur la crête -->
      <path class="rail" d="M60 838 L200 698 L250 728 L420 468 L470 508 L638 160" />

      <!-- Le grimpeur, en quelques traits : chaudron, buste, marteau -->
      <g class="grimpeur">
        <g class="grimpeur-corps">
          <path class="g-fond" d="M-16 -30 C-26 -24 -26 -6 -14 -1 C-6 2 6 2 14 -1 C26 -6 26 -24 16 -30 Z" />
          <path d="M-16 -30 C-26 -24 -26 -6 -14 -1 C-6 2 6 2 14 -1 C26 -6 26 -24 16 -30 Z" />
          <path d="M-19 -31 H19" />
          <path d="M-10 -31 C-12 -40 -10 -48 0 -50 C10 -48 12 -40 10 -31" />
          <path class="g-fond" d="M0 -60 m-7 0 a7 7 0 1 0 14 0 a7 7 0 1 0 -14 0" />
          <path d="M0 -60 m-7 0 a7 7 0 1 0 14 0 a7 7 0 1 0 -14 0" />
          <g class="bras">
            <path d="M-6 -44 L14 -40" />
            <path class="manche" d="M4 -34 L54 -70" />
            <path d="M48 -80 L62 -64" />
          </g>
        </g>
      </g>
    </g>

    <!-- ============ Le monde sans chute (chapitre III) ============ -->
    <g class="tableau" data-scenes="2">
      <path class="t" pathLength="1" d="M520 380 A130 130 0 1 0 330 300" />
      <path class="t" pathLength="1" d="M330 300 L306 352 M330 300 L384 314" />
      <path class="t fin" pathLength="1" d="M270 560 h260 a14 14 0 0 1 14 14 v62 a14 14 0 0 1 -14 14 h-260 a14 14 0 0 1 -14 -14 v-62 a14 14 0 0 1 14 -14 Z" />
      <text x="400" y="618" class="touche">Ctrl + Z</text>
    </g>

    <!-- ============ L'homme dans la jarre (chapitre IV) ============ -->
    <g class="tableau" data-scenes="3">
      <path class="t" pathLength="1" d="M560 200 m-44 0 a44 44 0 1 0 88 0 a44 44 0 1 0 -88 0" />
      <path class="t fin" pathLength="1" d="M560 128 V108 M560 272 V292 M488 200 H468 M632 200 H652 M509 149 L495 135 M611 251 L625 265 M509 251 L495 265 M611 149 L625 135" />
      <path class="t" pathLength="1" d="M330 420 Q240 500 260 640 Q280 760 380 780 Q480 760 500 640 Q520 500 430 420 Z" />
      <path class="t" pathLength="1" d="M322 420 H438 M332 404 H428" />
      <path class="t fin" pathLength="1" d="M276 560 Q380 586 484 560" />
      <path class="t fin" pathLength="1" d="M160 790 H640" />
    </g>

    <!-- ============ Fragile, robuste, plus fort (chapitre V) ============ -->
