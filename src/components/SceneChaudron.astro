      <path class="t fissure" pathLength="1" d="M148 396 L162 418 L148 436 L158 452 M182 390 L172 412" />
      <!-- le caillou -->
      <path class="t" pathLength="1" d="M346 548 Q334 490 378 470 Q432 448 458 492 Q474 534 446 548 Z" />
      <path class="t hachures" pathLength="1" d="M366 520 l14 -14 M392 530 l18 -18 M420 528 l16 -16" />
