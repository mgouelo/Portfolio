---
// Décor du récit : plusieurs tableaux dessinés au trait, un par moment de l'histoire.
// data-scenes : numéros des chapitres (à partir de 0) où le tableau ou l'élément est visible.
// Les tracés de classe « t » se dessinent à leur première apparition (voir scripts/recit.ts).
---
<div class="scene-fond" aria-hidden="true">
  <svg viewBox="0 0 800 900" fill="none" preserveAspectRatio="xMidYMid meet">
    <!-- ============ Tableau : la montagne (chapitres I, II, VI, VII) ============ -->
    <g class="tableau montagne" data-scenes="0 1 5 6">
      <!-- soleil au sommet, pour le dernier chapitre -->
      <g class="element" data-scenes="6">
        <path class="t" pathLength="1" d="M560 130 m-38 0 a38 38 0 1 0 76 0 a38 38 0 1 0 -76 0" />
        <path class="t" pathLength="1" d="M560 66 V46 M560 194 V214 M496 130 H476 M624 130 H644 M515 85 L501 71 M605 175 L619 189 M515 175 L501 189 M605 85 L619 71" />
      </g>

      <path class="massif t" pathLength="1" d="M0 900 L110 770 L170 800 L280 610 L330 650 L440 430 L500 480 L590 250 L640 290 L720 80 L800 190 V900 Z" />
      <!-- hachures façon gravure sur les flancs -->
      <path class="t hachures" pathLength="1" d="M150 830 l30 -36 M200 850 l40 -48 M300 700 l34 -40 M340 740 l44 -52 M470 540 l36 -44 M520 580 l46 -56 M620 360 l34 -42 M660 410 l46 -56 M740 200 l30 -40 M760 280 l34 -46" />
