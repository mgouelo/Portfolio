      <path class="t" pathLength="1" d="M640 548 C626 470 580 450 572 390 M640 548 C640 470 650 430 638 370 M640 548 C656 470 700 456 712 404" />
      <path class="t" pathLength="1" d="M572 390 m-13 0 a13 13 0 1 0 26 0 a13 13 0 1 0 -26 0 M638 370 m-13 0 a13 13 0 1 0 26 0 a13 13 0 1 0 -26 0" />
      <path class="t repousse" pathLength="1" d="M712 404 L690 352 M712 404 L742 356 M690 352 m-11 0 a11 11 0 1 0 22 0 a11 11 0 1 0 -22 0 M742 356 m-11 0 a11 11 0 1 0 22 0 a11 11 0 1 0 -22 0" />
      <path class="t coupure" pathLength="1" d="M694 430 L732 418" />
      <text x="160" y="680" class="etiquette">Fragile</text>
      <text x="400" y="680" class="etiquette">Robuste</text>
      <text x="640" y="680" class="etiquette">Plus fort</text>
    </g>
  </svg>
</div>

