      <path class="t fin" pathLength="1" d="M110 560 H210 V760 H110 Z M350 560 H450 V760 H350 Z M590 560 H690 V760 H590 Z" />
      <!-- verre fêlé -->
      <path class="t" pathLength="1" d="M130 410 Q130 480 160 488 Q190 480 190 410 Z M160 488 V540 M136 548 H184" />
      <path class="t fin" pathLength="1" d="M152 424 L164 444 L154 460 M176 418 L170 436" />
      <!-- caillou -->
      <path class="t" pathLength="1" d="M360 548 Q352 500 388 486 Q428 472 446 506 Q456 538 436 548 Z" />
      <!-- hydre : une tête coupée, deux qui repoussent -->
      <path class="t" pathLength="1" d="M640 548 C628 488 600 470 596 420 M640 548 C640 488 646 456 640 410 M640 548 C652 488 676 474 684 436" />
      <path class="t fin repousse" pathLength="1" d="M684 436 L670 400 M684 436 L704 402" />
