<!-- ===== Modal compétences ===== -->
<div class="modal" id="skill-modal" aria-hidden="true">
  <div class="modal__overlay" data-modal-close></div>
  <div class="modal__dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <button class="modal__close" type="button" aria-label="Fermer" data-modal-close>×</button>
    <h3 id="modal-title" class="modal__title">Détail</h3>

    <div class="modal__framewrap">
      <iframe class="modal__iframe" title="Détail compétence" loading="lazy"></iframe>
    </div>

    <div class="modal__actions">
      <button class="btn btn-primary" data-modal-close>Fermer</button>
    </div>
  </div>
</div>
